{
  "name": "legwork",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/reset.ts",
    "stellar:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-testnet.ts",
    "escrow:smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke-escrow.ts",
    "flow:smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke-flow.ts",
    "ai:eval": "node --env-file-if-exists=.env --import tsx scripts/ai-eval.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/genai": "^2.24.0",
    "@libsql/client": "^0.18.0",
    "@stellar/stellar-base": "^15.0.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.44.0",
    "next": "15.5.25",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.21.0",
    "swr": "^2.5.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
